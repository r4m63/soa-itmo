### Oscar 04. redistributeOscarRewards: ВНИМАНИЕ, изменяет DRAMA и MUSICAL
POST {{oscarBaseUrl}}/oscar/genres/redistribute-rewards/DRAMA/MUSICAL
Accept: application/json

> {%
client.test("200 и RedistributionResult", function () {
    client.assert(response.status === 200, "Ожидался статус 200");
    client.assert(Number.isInteger(response.body.sourceMovies) && response.body.sourceMovies >= 1, "sourceMovies должен быть не меньше 1");
    client.assert(Number.isInteger(response.body.targetMovies) && response.body.targetMovies >= 1, "targetMovies должен быть не меньше 1");
    client.assert(Number.isInteger(response.body.transferredOscars) && response.body.transferredOscars >= 0, "transferredOscars должен быть неотрицательным");
});
%}

