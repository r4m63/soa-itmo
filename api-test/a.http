### Movie 09. listMovies: пагинация по умолчанию
GET {{movieBaseUrl}}/movies
Accept: application/json

> {%
client.test("200 и схема MoviePage", function () {
    client.assert(response.status === 200, "Ожидался статус 200");
    client.assert(Array.isArray(response.body.items), "items должен быть массивом");
    client.assert(response.body.page === 0, "page по умолчанию должен быть 0");
    client.assert(response.body.size === 20, "size по умолчанию должен быть 20");
    client.assert(Number.isInteger(response.body.totalElements), "totalElements должен быть числом");
    client.assert(Number.isInteger(response.body.totalPages), "totalPages должен быть числом");
});
%}

### Movie 10. listMovies: OR-фильтры, сортировка и пагинация
GET {{movieBaseUrl}}/movies?filter=oscarsCount;gte;1&filter=name;contains;HTTP&sort=id;desc&page=0&size=5
Accept: application/json

> {%
client.test("200 и применённые параметры запроса", function () {
    client.assert(response.status === 200, "Ожидался статус 200");
    client.assert(response.body.page === 0 && response.body.size === 5, "Неверные page или size");
    client.assert(response.body.items.length <= 5, "Размер страницы превышен");
    client.assert(response.body.items.every(function (movie) {
        return movie.oscarsCount >= 1 || movie.name.includes("HTTP");
    }), "Нарушено OR-условие фильтров");
});
%}

### Movie 11. createMovie: полный MovieInput, сохранить ID для CRUD
POST {{movieBaseUrl}}/movies
Content-Type: application/json
Accept: application/json

{
  "name": "HTTP Client Movie",
  "coordinates": {"x": 51, "y": -120},
  "oscarsCount": 4,
  "genre": "DRAMA",
  "mpaaRating": "R",
  "screenwriter": {
    "name": "HTTP Author",
    "passportID": "ABC123456",
    "hairColor": "WHITE",
    "nationality": "UNITED_KINGDOM"
  }
}

> {%
client.test("201, Movie и Location", function () {
    client.assert(response.status === 201, "Ожидался статус 201");
    client.assert(Number.isInteger(response.body.id) && response.body.id > 0, "Сервис не вернул положительный id");
    client.assert(response.body.name === "HTTP Client Movie", "Неверное имя созданного фильма");
    client.assert(response.body.creationDate, "Отсутствует creationDate");
    client.assert(response.headers.valueOf("Location").endsWith("/movies/" + response.body.id), "Неверный Location");
});
if (response.status === 201) {
    client.global.set("movieId", response.body.id);
}
%}

### Movie 12. getMovieById: получить созданный фильм
GET {{movieBaseUrl}}/movies/{{movieId}}
Accept: application/json

> {%
client.test("200 и точный ID", function () {
    client.assert(response.status === 200, "Ожидался статус 200");
    client.assert(response.body.id === client.global.get("movieId"), "Возвращён другой фильм");
    client.assert(response.body.name === "HTTP Client Movie", "Неожиданное имя фильма");
});
%}

### Movie 13. updateMovie: изменить все редактируемые поля
PATCH {{movieBaseUrl}}/movies/{{movieId}}
Content-Type: application/json
Accept: application/json

{
  "name": "HTTP Client Movie Updated",
  "coordinates": {"x": 10, "y": 20},
  "oscarsCount": 6,
  "genre": "COMEDY",
  "mpaaRating": "PG_13",
  "screenwriter": {
    "name": "Updated Author",
    "passportID": "XYZ98765",
    "hairColor": "RED",
    "nationality": "FRANCE"
  }
}

> {%
client.test("200 и все поля обновлены", function () {
    client.assert(response.status === 200, "Ожидался статус 200");
    client.assert(response.body.name === "HTTP Client Movie Updated", "name не обновлён");
    client.assert(response.body.coordinates.x === 10 && response.body.coordinates.y === 20, "coordinates не обновлены");
    client.assert(response.body.oscarsCount === 6, "oscarsCount не обновлён");
    client.assert(response.body.genre === "COMEDY" && response.body.mpaaRating === "PG_13", "genre или mpaaRating не обновлены");
    client.assert(response.body.screenwriter.passportID === "XYZ98765", "screenwriter не обновлён");
});
%}

### Movie 14. updateMovie: сбросить nullable-поля
PATCH {{movieBaseUrl}}/movies/{{movieId}}
Content-Type: application/json
Accept: application/json

{
  "genre": null,
  "screenwriter": null
}

> {%
client.test("200, genre и screenwriter очищены", function () {
    client.assert(response.status === 200, "Ожидался статус 200");
    client.assert(response.body.genre == null, "genre не очищен");
    client.assert(response.body.screenwriter == null, "screenwriter не очищен");
});
%}

### Movie 15. updateMovie: пример ReadOnlyFields
PATCH {{movieBaseUrl}}/movies/{{movieId}}
Content-Type: application/json
Accept: application/json

{
  "id": 5,
  "creationDate": "2026-01-01"
}

> {%
client.test("400 и обе ошибки read-only полей", function () {
    client.assert(response.status === 400, "Ожидался статус 400");
    const fields = response.body.errors.map(function (error) { return error.field; }).sort();
    client.assert(JSON.stringify(fields) === JSON.stringify(["creationDate", "id"]), "Ожидались ошибки creationDate и id");
});
%}

### Movie 16. updateMovie: пустой MoviePatch
PATCH {{movieBaseUrl}}/movies/{{movieId}}
Content-Type: application/json
Accept: application/json

{}

> {%
client.test("400 для пустого MoviePatch", function () {
    client.assert(response.status === 400, "Ожидался статус 400");
    client.assert(Array.isArray(response.body.errors) && response.body.errors.length > 0, "Отсутствуют ошибки валидации");
});
%}

### Movie 17. createMovie: точный пример InvalidMovieFields
POST {{movieBaseUrl}}/movies
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "coordinates": {"x": 1, "y": 2},
  "oscarsCount": 0,
  "mpaaRating": "PG13",
  "screenwriter": {
    "name": "Author",
    "passportID": "AB12",
    "nationality": "FRANCE"
  }
}

> {%
client.test("400 и одновременно все четыре ошибки", function () {
    client.assert(response.status === 400, "Ожидался статус 400");
    client.assert(response.body.message === "Некорректное тело запроса", "Неверное message");
    const fields = response.body.errors.map(function (error) { return error.field; }).sort();
    client.assert(JSON.stringify(fields) === JSON.stringify(["mpaaRating", "name", "oscarsCount", "screenwriter.passportID"]), "Набор ошибок не совпадает с InvalidMovieFields");
});
%}

