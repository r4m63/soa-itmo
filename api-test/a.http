@movieBaseUrl = https://localhost:8181
@oscarBaseUrl = https://localhost:10081

### Movie 01. searchGenres: все значения
GET {{movieBaseUrl}}/movies/genres
Accept: application/json

> {%
client.test("200 и полный список жанров", function () {
    client.assert(response.status === 200, "Ожидался статус 200");
    client.assert(JSON.stringify(response.body.items) === JSON.stringify(["ACTION", "DRAMA", "COMEDY", "MUSICAL", "HORROR"]), "Неожиданный список жанров");
});
%}

