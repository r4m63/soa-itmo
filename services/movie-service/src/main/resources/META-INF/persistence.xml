<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="movies" transaction-type="JTA">
        <!-- JDBC-ресурс PostgreSQL создаётся в Payara: asadmin create-jdbc-resource ... jdbc/movies -->
        <jta-data-source>jdbc/movies</jta-data-source>
        <class>com.itmo.soa.movie.infrastructure.storage.movie.model.MovieEntity</class>
        <class>com.itmo.soa.movie.infrastructure.storage.movie.model.CoordinatesEmbeddable</class>
        <class>com.itmo.soa.movie.infrastructure.storage.movie.model.ScreenwriterEmbeddable</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <!-- схемой управляет Flyway (db/migration) -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
        </properties>
    </persistence-unit>
</persistence>
